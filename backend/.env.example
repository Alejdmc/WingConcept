# WingConcept Backend — Variables de Entorno
# Equipo: ZomiDev
# IMPORTANTE: Copiar este archivo a .env y rellenar los valores
# NUNCA commitear el .env con valores reales

# App
APP_NAME=WingConcept API
APP_VERSION=1.0.0
ENVIRONMENT=development        # development | staging | production
DEBUG=True
API_V1_PREFIX=/api/v1

# --- Servidor ---
HOST=0.0.0.0
PORT=8000

# BASE DE DATOS — Supabase PostgreSQL
# Panel: https://app.supabase.com → Settings → Database
# Formato: postgresql://[user]:[password]@[host]:[port]/[db] (se me olvida)
DATABASE_URL=postgresql+asyncpg://postgres:[PASSWORD]@db.[PROJECT_ID].supabase.co:5432/postgres

# SUPABASE (Storage) — raíz del proyecto, NO la connection string de Postgres
# Panel: https://supabase.com/dashboard → Project → Settings → API
# SUPABASE_SERVICE_KEY = service_role (secreto, empieza con eyJ... o sb_secret_...)
# SUPABASE_ANON_KEY    = anon / publishable (público, eyJ... o sb_publishable_...)
SUPABASE_URL=https://[PROJECT_ID].supabase.co
SUPABASE_SERVICE_KEY=eyJ...service_role_key
SUPABASE_ANON_KEY=eyJ...anon_key
SUPABASE_BUCKET_PRODUCTOS=productos
SUPABASE_BUCKET_MODELOS_3D=modelos3d
SUPABASE_BUCKET_MANUALS=manuals

# REDIS — Cache, sesiones, rate limiting, carrito anónimo
# Docker: redis:6379 | Producción: Redis Cloud o Upstash
REDIS_HOST=localhost            # local dev: localhost | Docker: redis (nombre del servicio)
REDIS_PORT=6379
REDIS_PASSWORD=                # Dejar vacío si no tiene contraseña
REDIS_DB=0
REDIS_CART_TTL=86400           # Segundos que vive el carrito anónimo (24h)
REDIS_CACHE_TTL=300            # Segundos de cache para productos (5min)

# JWT — Autenticación
# Generar SECRET_KEY con: openssl rand -hex 32
SECRET_KEY=CAMBIAR_POR_CLAVE_SEGURA_GENERADA_CON_OPENSSL
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# STRIPE — Pagos (USD)
# Panel: https://dashboard.stripe.com
# Docs: https://stripe.com/docs/api
STRIPE_SECRET_KEY=sk_test_OBTENER_EN_DASHBOARD_STRIPE
STRIPE_PUBLISHABLE_KEY=pk_test_OBTENER_EN_DASHBOARD_STRIPE
STRIPE_WEBHOOK_SECRET=whsec_OBTENER_EN_DASHBOARD_STRIPE
STRIPE_CURRENCY=usd
STRIPE_SUCCESS_URL=http://localhost:3000/checkout/exito
STRIPE_CANCEL_URL=http://localhost:3000/checkout/cancelado

# RESEND — Email transaccional
# Panel: https://resend.com/overview
# Docs: https://resend.com/docs
# Requiere verificar dominio en DNS
RESEND_API_KEY=re_OBTENER_EN_PANEL_RESEND
FROM_EMAIL=noreply@wingconcept.com
FROM_NAME=WingConcept
ALLOWED_ORIGINS=http://localhost:3000,https://wingconcept.com,https://www.wingconcept.com

# URL del frontend (links en emails de verificación y recuperación)
FRONTEND_URL=http://localhost:3000

# Hosts confiables (TrustedHostMiddleware)
ALLOWED_HOSTS=localhost,127.0.0.1

# Bloquear crear órdenes/pagos si email_verificado=False (siempre activo en rutas sensibles)
REQUIRE_EMAIL_VERIFIED=true
# Verificar registros MX/DNS del dominio (solo aplica en producción si True)
EMAIL_CHECK_DELIVERABILITY=false
EMAIL_VERIFY_EXPIRE_HOURS=24

# LOGGING
# Niveles: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# UPLOADS / STORAGE
MAX_UPLOAD_SIZE_MB=10
MAX_MANUAL_UPLOAD_SIZE_MB=25
ALLOWED_MANUAL_TYPES=application/pdf
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
ALLOWED_MODEL_TYPES=model/gltf-binary,model/gltf+json,application/octet-stream

# Admin invitations
# Dev local: set true to enable admin invitations (always false in production)
ALLOW_NEW_ADMINS=false
ADMIN_INVITE_EXPIRE_DAYS=7

# Contact form (defaults to FROM_EMAIL if empty)
CONTACT_EMAIL=info@wingconcept.com
# Admin alert when a payment is confirmed
ADMIN_ORDER_EMAIL=andres@wingconcept.com

# Cloudflare Turnstile (CAPTCHA) — https://dash.cloudflare.com → Turnstile
# Dejar vacío en dev local para desactivar captcha
TURNSTILE_SECRET_KEY=

# Inventario — alerta admin cuando stock <= este valor (partes/accesorios)
LOW_STOCK_THRESHOLD=2

