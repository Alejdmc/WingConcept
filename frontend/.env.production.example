# Producción — mismo servidor que el backend (nginx proxy)
# No definir NEXT_PUBLIC_API_URL: el navegador usa /api/v1 relativo.
# Desarrollo local: copiar a .env.local con NEXT_PUBLIC_API_URL=http://localhost:8000

# URL pública del sitio (favicon en Google, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.wingconcept.com

# Cloudflare Turnstile (CAPTCHA) — https://dash.cloudflare.com → Turnstile
# Site key (pública) — debe coincidir con TURNSTILE_SECRET_KEY del backend
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
