{
  "name": "wing-concept",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "cross-env NODE_OPTIONS='--no-experimental-webstorage' next dev",
    "dev:clean": "rm -rf .next node_modules/.cache && cross-env NODE_OPTIONS='--no-experimental-webstorage' next dev",
    "build:clean": "rm -rf .next node_modules/.cache && next build",
    "backend": "cd ../backend && ../.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000 --reload",
    "build": "next build",
    "start": "next start",
    "lint": "next lint"
  },
  "dependencies": {
    "framer-motion": "^12.40.0",
    "lucide-react": "^0.511.0",
    "next": "16.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "autoprefixer": "^10.5.0",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.19"
  }
}
